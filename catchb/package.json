{
  "name": "catchb",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./src/test-utils/jest.setup.tsx"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/jest",
      "/android",
      "/ios"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/app/**/*.{js,jsx,ts,tsx}",
      "!src/**/*/context.ts",
      "!src/**/*/index.ts",
      "!src/**/*/styles.ts",
      "!src/**/*/types.ts",
      "!src/**/*.d.ts",
      "!src/test-utils/renderer.tsx",
      "!src/**/*/__mocks__.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__mocks__\\.ts$"
    ]
  },
  "dependencies": {
    "@actbase/react-daum-postcode": "^1.0.4",
    "@mj-studio/react-native-naver-map": "^2.3.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-kakao/core": "^2.3.0",
    "@react-native-kakao/user": "^2.3.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-seoul/naver-login": "^4.0.5",
    "@tanstack/react-query": "^5.74.7",
    "axios": "^1.8.4",
    "expo": "~52.0.46",
    "expo-application": "~6.0.2",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-network": "~7.0.5",
    "expo-router": "~4.0.20",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-svg": "15.8.0",
    "styled-components": "^6.1.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.24.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/styled-components": "^5.1.34",
    "@types/styled-components-react-native": "^5.2.5",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.6",
    "react-native-svg-transformer": "^1.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "private": true
}

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@pages/*": [
        "./src/02.pages/*"
      ],
      "@widgets/*": [
        "./src/03.widgets/*"
      ],
      "@features/*": [
        "./src/04.features/*"
      ],
      "@entities/*": [
        "./src/05.entities/*"
      ],
      "@shared/*": [
        "./src/06.shared/*"
      ],
      "@test-utils/*": [
        "./src/test-utils/*"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

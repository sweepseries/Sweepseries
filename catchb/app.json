{
  "expo": {
    "name": "Catch B",
    "slug": "catchb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catchb",
    "userInterfaceStyle": "light",
    "owner": "catchb",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sweepseries.catchb",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sweepseries.catchb",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven",
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "dce93da02c80e20f571ef4ad6d7a28d2",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "이 기기에서 Face ID를 사용하여 로그인할 수 있습니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "캐치비가 사진에 접근할 수 있도록 허용해주세요.",
          "cameraPermission": "캐치비가 카메라에 접근할 수 있도록 허용해주세요."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NPSfont_bold.ttf",
            "./assets/fonts/NPSfont_extrabold.ttf",
            "./assets/fonts/NPSfont_regular.ttf"
          ]
        }
      ],
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3fb30a16-250a-4bbd-a1b1-33e360a9a292"
      }
    }
  }
}
